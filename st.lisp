;;;; st.lisp — minimal safetensors reader (F32 tensors, single-file models).
(defpackage :st
  (:use :cl)
  (:export #:parse-header #:get-tensor #:get-tensor-opt #:tensor-names))
(in-package :st)

(defun parse-header (path)
  "Returns (values header-hash data-start-offset)."
  (with-open-file (in path :direction :input :element-type '(unsigned-byte 8))
    (let ((len-buf (make-array 8 :element-type '(unsigned-byte 8))))
      (read-sequence len-buf in)
      (let ((header-len 0))
        (loop for i below 8
              do (setf header-len (logior header-len
                                          (ash (aref len-buf i) (* 8 i)))))
        (let ((json-buf (make-array header-len :element-type '(unsigned-byte 8))))
          (read-sequence json-buf in)
          (values (json:parse
                   (coerce (mapcar #'code-char (coerce json-buf 'list)) 'string))
                  (+ 8 header-len)))))))

(declaim (inline half-to-float))
(defun half-to-float (h)
  "IEEE 754 binary16 -> single-float."
  (let ((sign (if (logbitp 15 h) -1.0 1.0))
        (exp (ldb (byte 5 10) h))
        (mant (ldb (byte 10 0) h)))
    (cond ((zerop exp) (* sign (expt 2.0 -14) (/ mant 1024.0)))
          ((= exp 31) (* sign most-positive-single-float))
          (t (* sign (expt 2.0 (- exp 15)) (+ 1.0 (/ mant 1024.0)))))))

(defun get-tensor (path header name)
  "Read one tensor (F32 / BF16 / F16) -> (simple-array single-float (*))."
  (let* ((info (gethash name header))
         (dtype (gethash "dtype" info))
         (offs (gethash "data_offsets" info))
         (start (+ (gethash "data-start" header) (first offs)))
         (n (reduce #'* (gethash "shape" info)))
         (arr (make-array n :element-type 'single-float)))
    (cond
      ((string= dtype "F32")
       (let ((buf (make-array 65536 :element-type '(unsigned-byte 32))))
         (with-open-file (in path :direction :input :element-type '(unsigned-byte 32))
           (file-position in (floor start 4))
           (let ((pos 0))
             (loop while (< pos n)
                   do (let ((got (read-sequence buf in :end (min (- n pos) 65536))))
                        (when (= got 0) (error "EOF in tensor ~A" name))
                        (sb-sys:with-pinned-objects (buf arr)
                          (let ((src (sb-alien:sap-alien (sb-sys:vector-sap buf)
                                                         (* (sb-alien:unsigned 32))))
                                (dst (sb-alien:sap-alien (sb-sys:vector-sap arr)
                                                         (* (sb-alien:unsigned 32)))))
                            (dotimes (i got)
                              (setf (sb-alien:deref dst (+ pos i))
                                    (sb-alien:deref src i)))))
                        (incf pos got)))))))
      ((string= dtype "BF16")
       (let ((buf (make-array 65536 :element-type '(unsigned-byte 16))))
         (with-open-file (in path :direction :input :element-type '(unsigned-byte 16))
           (file-position in (floor start 2))
           (let ((pos 0))
             (loop while (< pos n)
                   do (let ((got (read-sequence buf in :end (min (- n pos) 65536))))
                        (when (= got 0) (error "EOF in tensor ~A" name))
                        (dotimes (i got)
                          (let ((bits (ash (aref buf i) 16)))
                            (setf (aref arr (+ pos i))
                                  (sb-kernel:make-single-float
                                   (if (logbitp 31 bits)
                                       (- bits #x100000000)
                                       bits)))))
                        (incf pos got)))))))
      ((string= dtype "F16")
       (let ((buf (make-array 65536 :element-type '(unsigned-byte 16))))
         (with-open-file (in path :direction :input :element-type '(unsigned-byte 16))
           (file-position in (floor start 2))
           (let ((pos 0))
             (loop while (< pos n)
                   do (let ((got (read-sequence buf in :end (min (- n pos) 65536))))
                        (when (= got 0) (error "EOF in tensor ~A" name))
                        (dotimes (i got)
                          (setf (aref arr (+ pos i)) (half-to-float (aref buf i))))
                        (incf pos got)))))))
      (t (error "tensor ~A has unsupported dtype ~A" name dtype)))
    arr))

(defun get-tensor-opt (path header name)
  (when (gethash name header) (get-tensor path header name)))


(defun tensor-names (header)
  (loop for k being the hash-keys of header
        unless (string= k "data-start") collect k))
